# LLM provider for narration and the assistant: auto | gemini | ollama | none
# "auto" prefers Gemini and falls back to Ollama. Switchable at runtime from the
# assistant page (PUT /assistant/provider); that override is not persisted.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Copy to backend/.env and fill in. config.py resolves backend/.env relative to
# the module, so the file must live at backend/.env regardless of where you
# launch uvicorn from. .env* is gitignored; never commit real values.

# Target instance. MUST connect as the read-only inspector_ro role, not postgres.
# Percent-encode special characters in the password: @ %40  # %23  / %2F  ? %3F  : %3A
# postgresql://inspector_ro:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
TARGET_DATABASE_URL=

# Optional, off by default. Opt-in higher-privilege connection used ONLY for
# data-shape checks that require reading rows (README section 4.4). When unset,
# those checks report INDETERMINATE rather than being skipped.
TARGET_ELEVATED_DATABASE_URL=

# Optional. Control-plane instance (orgs, scans, chats). Unset => in-memory mode.
# Note the exact name: CONTROL_PLANE_DATABASE_URL would read as unset.
CONTROL_PLANE_DB_URL=

# Optional. Control-plane Supabase project. Unset => demo-mode auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Gemini narration and the function-calling assistant.
# Diagnostics run without it; only the natural-language layer is lost.
GEMINI_API_KEY=

# Auth posture. Defaults to "production" in config.py, which REQUIRES a verified
# token on every protected route. Set to "development" for local demo use, which
# answers unauthenticated requests as a hardcoded demo user and prints a loud
# warning banner at startup. Never ship "development".
ENVIRONMENT=development
